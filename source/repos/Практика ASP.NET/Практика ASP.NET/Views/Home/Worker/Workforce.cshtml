@{
    ViewData["Title"] = "Workforce";
}
@model IEnumerable<Workforce>
@section WorkersStyle {
    <link rel="stylesheet" href="~/css/WorkersSheet.css" asp-append-version="true" />
}
<h1>Штат Сотрудников</h1>
<p>Сотрудники:</p>
<table class="table">
    <thead>
        <tr>
            <th>Имя</th>
            <th>Должность</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var Workforce in Model)
        {
            <tr>
                <td>@Workforce.FullName</td>
                <td>@Workforce.workerRole</td>
                <td>
                    <a asp-action="Details" asp-route-id="@Workforce.Id">Подробнее</a>
                </td>
            </tr>
        }
    </tbody>
</table>